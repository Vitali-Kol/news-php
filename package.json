{
  "name": "news-php-tests",
  "version": "1.0.0",
  "description": "Playwright Visual End-to-End (E2E) tests for NewsPortal PHP MVC",
  "scripts": {
    "test": "playwright test",
    "test2": "node tests/run_all_tests.js",
    "test:unit": "node tests/unit/run_unit.js",
    "test:integration": "node tests/integration/run_integration.js",
    "test:all": "node tests/run_all_tests.js && playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "author": "Vitali-Kol",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.58.2"
  }
}
